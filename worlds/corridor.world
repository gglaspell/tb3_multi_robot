<?xml version="1.0"?>
<sdf version="1.8">
  <world name="corridor">
    <physics name="accurate_1ms" type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.0</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.85 0.9 0.95 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 8</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 8</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.82 0.82 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="arena_geometry">
      <static>true</static>
      <link name="geometry_link">
      <collision name="north_wall_collision">
        <pose>0 3.9 0.4 0 0 0</pose>
        <geometry><box><size>12 0.2 0.8</size></box></geometry>
      </collision>
      <visual name="north_wall_visual">
        <pose>0 3.9 0.4 0 0 0</pose>
        <geometry><box><size>12 0.2 0.8</size></box></geometry>
        <material>
          <ambient>0.62 0.46 0.27 1</ambient>
          <diffuse>0.62 0.46 0.27 1</diffuse>
        </material>
      </visual>
      <collision name="south_wall_collision">
        <pose>0 -3.9 0.4 0 0 0</pose>
        <geometry><box><size>12 0.2 0.8</size></box></geometry>
      </collision>
      <visual name="south_wall_visual">
        <pose>0 -3.9 0.4 0 0 0</pose>
        <geometry><box><size>12 0.2 0.8</size></box></geometry>
        <material>
          <ambient>0.62 0.46 0.27 1</ambient>
          <diffuse>0.62 0.46 0.27 1</diffuse>
        </material>
      </visual>
      <collision name="east_wall_collision">
        <pose>5.9 0 0.4 0 0 0</pose>
        <geometry><box><size>0.2 8 0.8</size></box></geometry>
      </collision>
      <visual name="east_wall_visual">
        <pose>5.9 0 0.4 0 0 0</pose>
        <geometry><box><size>0.2 8 0.8</size></box></geometry>
        <material>
          <ambient>0.62 0.46 0.27 1</ambient>
          <diffuse>0.62 0.46 0.27 1</diffuse>
        </material>
      </visual>
      <collision name="west_wall_collision">
        <pose>-5.9 0 0.4 0 0 0</pose>
        <geometry><box><size>0.2 8 0.8</size></box></geometry>
      </collision>
      <visual name="west_wall_visual">
        <pose>-5.9 0 0.4 0 0 0</pose>
        <geometry><box><size>0.2 8 0.8</size></box></geometry>
        <material>
          <ambient>0.62 0.46 0.27 1</ambient>
          <diffuse>0.62 0.46 0.27 1</diffuse>
        </material>
      </visual>
      <collision name="north_stagger_collision">
        <pose>-2 1 0.4 0 0 0</pose>
        <geometry><box><size>5 0.2 0.8</size></box></geometry>
      </collision>
      <visual name="north_stagger_visual">
        <pose>-2 1 0.4 0 0 0</pose>
        <geometry><box><size>5 0.2 0.8</size></box></geometry>
        <material>
          <ambient>0.62 0.46 0.27 1</ambient>
          <diffuse>0.62 0.46 0.27 1</diffuse>
        </material>
      </visual>
      <collision name="south_stagger_collision">
        <pose>2 -1 0.4 0 0 0</pose>
        <geometry><box><size>5 0.2 0.8</size></box></geometry>
      </collision>
      <visual name="south_stagger_visual">
        <pose>2 -1 0.4 0 0 0</pose>
        <geometry><box><size>5 0.2 0.8</size></box></geometry>
        <material>
          <ambient>0.62 0.46 0.27 1</ambient>
          <diffuse>0.62 0.46 0.27 1</diffuse>
        </material>
      </visual>
      <collision name="west_gate_collision">
        <pose>-3 -1.8 0.4 0 0 0</pose>
        <geometry><box><size>0.2 2 0.8</size></box></geometry>
      </collision>
      <visual name="west_gate_visual">
        <pose>-3 -1.8 0.4 0 0 0</pose>
        <geometry><box><size>0.2 2 0.8</size></box></geometry>
        <material>
          <ambient>0.62 0.46 0.27 1</ambient>
          <diffuse>0.62 0.46 0.27 1</diffuse>
        </material>
      </visual>
      <collision name="east_gate_collision">
        <pose>3 1.8 0.4 0 0 0</pose>
        <geometry><box><size>0.2 2 0.8</size></box></geometry>
      </collision>
      <visual name="east_gate_visual">
        <pose>3 1.8 0.4 0 0 0</pose>
        <geometry><box><size>0.2 2 0.8</size></box></geometry>
        <material>
          <ambient>0.62 0.46 0.27 1</ambient>
          <diffuse>0.62 0.46 0.27 1</diffuse>
        </material>
      </visual>
      </link>
    </model>
  </world>
</sdf>
